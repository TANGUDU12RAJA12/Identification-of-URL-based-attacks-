# Generate attack data
def generate_attack_data():
    # Select attack category based on weights
    categories = list(ATTACK_DISTRIBUTION.keys())
    weights = [ATTACK_DISTRIBUTION[c]['weight'] for c in categories]
    attack_category = random.choices(categories, weights=weights)[0]
    
    # Select subtype
    subtype_info = ATTACK_DISTRIBUTION[attack_category]
    subtype = random.choice(subtype_info['subtypes'])
    
    # Generate URL and payload based on attack type
    if attack_category == 'sql_injection':
        payload = generate_sqli_payload(subtype)
        base_url = '/products?id='
        if random.random() < 0.5:
            base_url = '/search?q='
        elif random.random() < 0.3:
            base_url = '/user?username='
        else:
            base_url = '/login?user='
        url = base_url + urllib.parse.quote(payload)
        request_body = ''
        method = 'GET'
        
    elif attack_category == 'xss':
        payload = generate_xss_payload(subtype)
        if random.random() < 0.6:
            url = '/search?q=' + urllib.parse.quote(payload)
            method = 'GET'
            request_body = ''
        else:
            url = '/comment'
            method = 'POST'
            request_body = f'comment={urllib.parse.quote(payload)}'
        
    elif attack_category == 'directory_traversal':
        payload = generate_traversal_payload(subtype)
        url = '/download?file=' + urllib.parse.quote(payload)
        if random.random() < 0.3:
            url = '/view?path=' + urllib.parse.quote(payload)
        method = 'GET'
        request_body = ''
        
    elif attack_category == 'command_injection':
        payload = generate_cmd_injection_payload(subtype)
        url = '/ping?ip=127.0.0.1' + urllib.parse.quote(payload)
        if random.random() < 0.4:
            url = '/traceroute?host=' + urllib.parse.quote(payload)
        method = 'GET'
        request_body = ''
        
    elif attack_category == 'ssrf':
        payload = generate_ssrf_payload(subtype)
        url = '/fetch?url=' + urllib.parse.quote(payload)
        if random.random() < 0.5:
            url = '/proxy?target=' + urllib.parse.quote(payload)
        method = 'GET'
        request_body = ''
        
    elif attack_category == 'credential_stuffing_brute_force':
        payload = generate_credential_payload(subtype)
        url = '/login'
        method = 'POST'
        request_body = payload
        
    else:  # typosquatting
        malicious_domain = generate_typosquatting_url(subtype)
        url = f'https://{malicious_domain}/login'
        if random.random() < 0.4:
            url += '?redirect=/dashboard'
        method = 'GET'
        request_body = ''
        payload = malicious_domain
    
    # Determine response code based on attack and randomness
    if random.random() < 0.3:  # 30% success-like responses
        response_code = random.choices([200, 302], weights=[0.7, 0.3])[0]
    else:
        response_code = random.choices([403, 404, 500, 401], weights=[0.3, 0.3, 0.2, 0.2])[0]
    
    response_size = random.randint(100, 8000)
    
    # Attack tools user agents
    attack_uas = USER_AGENTS[10:15] + USER_AGENTS[:3]
    
    return {
        'url': url,
        'http_method': method,
        'request_body': request_body,
        'response_code': response_code,
        'response_size': response_size,
        'user_agent': random.choice(attack_uas),
        'payload_raw': payload,
        'attack_type_label': attack_category
    }

